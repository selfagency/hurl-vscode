{
  "name": "pfeifer-hurl",
  "displayName": "Hurl",
  "version": "0.1.0",
  "description": "Provides syntax highlighting for hurl",
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/selfagency/hurl-vscode"
  },
  "license": "Apache-2.0",
  "author": "Daniel Sieradski <daniel@self.agency>",
  "publisher": "selfagency",
  "main": "./out/extension.js",
  "scripts": {
    "compile": "tsc -p ./",
    "format": "oxfmt",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "pretest": "npm run compile && npm run lint",
    "test": "node ./out/test/runTest.js",
    "vscode:prepublish": "npm run compile",
    "watch": "tsc -watch -p ./"
  },
  "contributes": {
    "commands": [
      {
        "command": "hurl.hurl",
        "title": "Hurl"
      }
    ],
    "languages": [
      {
        "id": "hurl",
        "extensions": [
          ".hurl"
        ],
        "configuration": "./language-configuration.json"
      }
    ]
  },
  "activationEvents": [
    "onCommand:hurl.hurl",
    "onLanguage:hurl"
  ],
  "devDependencies": {
    "@types/glob": "9.0.0",
    "@types/node": "~20.19.33",
    "@types/vscode": "^1.109.0",
    "@vscode/test-electron": "^2.5.2",
    "ansi-to-html": "^0.7.2",
    "glob": "13.0.6",
    "oxfmt": "^0.35.0",
    "oxlint": "^1.50.0",
    "oxlint-tsgolint": "^0.14.2",
    "radashi": "^12.7.1",
    "typescript": "5.9.3",
    "vitest": "^4.0.18",
    "vsce": "^2.15.0",
    "vscode-languageclient": "^9.0.1",
    "vscode-languageserver": "^9.0.1",
    "web-tree-sitter": "^0.26.5"
  },
  "engines": {
    "vscode": "^1.74.0"
  },
  "icon": "hurl-icon.png",
  "packageManager": "pnpm@10.30.0+sha512.2b5753de015d480eeb88f5b5b61e0051f05b4301808a82ec8b840c9d2adf7748eb352c83f5c1593ca703ff1017295bc3fdd3119abb9686efc96b9fcb18200937"
}